# Copy to .env. Leave a key blank if you are not using that service.
# The offline demo (L3MN05_OFFLINE=1 python demo_run.py) needs none of these.

# Local model. Docker Compose overrides the URL to http://ollama:11434/v1.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5-coder:14b

# 1 refuses outbound calls (Jira, GitHub, Notion, Slack, remote models).
L3MN05_OFFLINE=0

# Optional remote validation and the chat/Slack front ends.
REMOTE_API_KEY=
GROK_API_KEY=

# Optional ticket source and pull requests.
JIRA_API_TOKEN=
GITHUB_TOKEN=

# Optional Slack bot. Ignored while L3MN05_OFFLINE=1.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
